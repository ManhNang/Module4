# ==============================================================================
# Mẫu biến môi trường cho Pokémon Blindbox (Copy vào Render -> Environment)
# Tuyệt đối KHÔNG commit file .env chứa giá trị thật lên Git!
# ==============================================================================

# 1. Spring Profile & Port (Render tự cấp PORT)
SPRING_PROFILES_ACTIVE=prod
SPRING_SESSION_STORE_TYPE=none

# 2. MySQL Database (Aiven / TiDB Cloud / Clever Cloud / Railway MySQL)
SPRING_DATASOURCE_URL=jdbc:mysql://<DB_HOST>:<DB_PORT>/<DB_NAME>?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

# 3. Redis (Optional - nếu bật Redis Session/Cache như Upstash hoặc Render Key Value)
# SPRING_SESSION_STORE_TYPE=redis
# SPRING_DATA_REDIS_HOST=<REDIS_HOST>
# SPRING_DATA_REDIS_PORT=6379
# SPRING_DATA_REDIS_PASSWORD=<REDIS_PASSWORD>
# SPRING_DATA_REDIS_SSL=true

# 4. Security & WebSocket (BẮT BUỘC đặt chuỗi ngẫu nhiên >= 32 ký tự và đúng domain Render)
APP_REMEMBER_ME_KEY=<RANDOM_SECRET_KEY_32_CHARS>
APP_WS_ALLOWED_ORIGINS=https://<your-app-name>.onrender.com

# 5. Cloudinary (Upload ảnh thẻ bài)
CLOUDINARY_CLOUD_NAME=<YOUR_CLOUD_NAME>
CLOUDINARY_API_KEY=<YOUR_API_KEY>
CLOUDINARY_API_SECRET=<YOUR_API_SECRET>

# 6. SePay VietQR (Tài khoản ngân hàng cá nhân nhận tiền nạp)
SEPAY_BANK_CODE=TPB
SEPAY_ACCOUNT_NUMBER=<YOUR_BANK_ACCOUNT_NUMBER>
SEPAY_ACCOUNT_NAME=<YOUR_FULL_NAME_NO_ACCENT>
SEPAY_WEBHOOK_API_KEY=<YOUR_SEPAY_WEBHOOK_API_KEY>
SEPAY_QR_TEMPLATE=compact
SEPAY_CODE_PREFIX=PKM
